# ─────────────────────────────────────────────────────────────────────
# Smart SIEM — environment variables (dev defaults — non-production)
# ─────────────────────────────────────────────────────────────────────
# Copier ce fichier en `.env` à la racine du projet et adapter les valeurs.
# En production, l'intégralité des secrets DOIT être injectée par un
# orchestrateur (Docker Swarm, Kubernetes, Vault, etc.).
# ─────────────────────────────────────────────────────────────────────

# ── Environnement ────────────────────────────────────────────────
APP_ENV=dev                       # dev | staging | prod
DOCS_ENABLED=true                 # désactivé en prod (false)

# ── API ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["https://localhost","http://localhost:3000"]
ALLOWED_HOSTS=["localhost","siem.local"]

# ── JWT (RF-SEC-01) ──────────────────────────────────────────────
# En prod : utiliser une clé générée par `python -c "import secrets; print(secrets.token_urlsafe(48))"`
API_SECRET_KEY=dev-only-not-for-production-min-32-chars-XXXX
JWT_ALGORITHM=HS256               # HS256|HS384|HS512|RS256|ES256
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_MINUTES=1440
JWT_ACCESS_LEEWAY_SECONDS=30
JWT_ISSUER=smart-siem
JWT_AUDIENCE=smart-siem-api

# ── MFA (NFR-SEC-02) ─────────────────────────────────────────────
MFA_REQUIRED=false
MFA_ISSUER=SmartSIEM
MFA_TOTP_DIGITS=6
MFA_TOTP_PERIOD=30

# ── Politique mot de passe (NFR-SEC-03) ─────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=true
PASSWORD_HISTORY_SIZE=5

# ── SOAR / actions réseau (RF-SEC-05) ───────────────────────────
BLOCK_IP_DRY_RUN=true
BLOCK_IP_MAX_PER_HOUR=50
BLOCK_IP_REQUIRE_APPROVAL_BELOW=CRITICAL
SOAR_REQUIRE_APPROVAL=true
SOAR_KILL_SWITCH=false
SOAR_ALLOW_PRIVATE_NETWORKS=false

# ── Headers sécurité (NFR-SEC-05) ──────────────────────────────
HSTS_MAX_AGE=31536000
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# ── Elasticsearch ───────────────────────────────────────────────
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_TLS_VERIFY=false
ELASTICSEARCH_CA_CERTS=
ELASTICSEARCH_REQUEST_TIMEOUT=10
ELASTICSEARCH_MAX_RETRIES=2

# ── PostgreSQL (correlation_engine/) ─────────────────────────────
# Utilisé uniquement par le moteur de corrélation (règles, alertes, playbooks).
# Le backend API reste 100% Elasticsearch.
POSTGRES_PASSWORD=postgres

# ── Notifications ───────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=siem@example.com
SMTP_TLS=true
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
PAGERDUTY_ROUTING_KEY=
WEBHOOK_REQUIRE_HTTPS=true

# ── Rétention / divers ──────────────────────────────────────────
LOG_RETENTION_DAYS=30
CORRELATION_POLL_SECONDS=5

# ── Syslog TLS ──────────────────────────────────────────────────
SYSLOG_TLS_PORT=6514
SYSLOG_CERT_PATH=/certs/syslog-server.crt
SYSLOG_KEY_PATH=/certs/syslog-server.key
